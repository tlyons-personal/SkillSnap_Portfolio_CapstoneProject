@* Current user's profile editor, plus account deletion. *@
@page "/profile"
@attribute [Authorize]
@implements IDisposable
@using SkillSnap.Shared.Models
@using SkillSnap.Client.Services
@inject PortfolioUserService PortfolioUsers 
@inject AuthService Auth
@inject NavigationManager Navigation

<h1>My Profile</h1>

@if (_user is null)
{
    <p>Loading…</p>
}
else
{
    <EditForm Model="_user" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">First name</label>
            <InputText class="form-control" @bind-Value="_user.FirstName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Last name</label>
            <InputText class="form-control" @bind-Value="_user.LastName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Bio</label>
            <InputTextArea class="form-control" @bind-Value="_user.Bio" rows="4" />
        </div>
        <div class="mb-3">
            <label class="form-label">Profile image URL</label>
            <InputText class="form-control" @bind-Value="_user.ProfileImageUrl" />
        </div>
        <button class="btn btn-primary" type="submit">Save changes</button>
        @if (_saved) { <span class="text-success ms-2">Saved!</span> }
        @if (!string.IsNullOrEmpty(_saveError)) { <span class="text-danger ms-2">@_saveError</span> }
    </EditForm>
}

<hr class="my-4" />

<section class="danger-zone">
    <h2 class="h5 text-danger">Delete account</h2>
    <p class="text-muted">
        Permanently delete your account along with your profile, projects, and skills.
        This cannot be undone.
    </p>

    @if (!string.IsNullOrEmpty(_deleteError))
    {
        <div class="alert alert-danger" role="alert">@_deleteError</div>
    }

    @if (!_confirmingDelete)
    {
        <button class="btn btn-outline-danger" @onclick="() => _confirmingDelete = true">
            Delete my account
        </button>
    }
    else
    {
        <div class="alert alert-warning">
            Are you sure? This will permanently remove your account.
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-danger" disabled="@_deleting" @onclick="DeleteAccountAsync">
                @(_deleting ? "Deleting…" : "Yes, delete my account")
            </button>
            <button class="btn btn-secondary" disabled="@_deleting" @onclick="() => _confirmingDelete = false">
                Cancel
            </button>
        </div>
    }
</section>

@code {
    private PortfolioUser? _user;
    private bool _saved;
    private string? _saveError;
    private bool _confirmingDelete;
    private bool _deleting;
    private string? _deleteError;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
        => _user = await PortfolioUsers.GetMyProfileAsync(_cts.Token);

    private async Task SaveAsync()
    {
        _saved = false;
        _saveError = null;
        try
        {
            await PortfolioUsers.UpdateMyProfileAsync(_user!, _cts.Token);
            _saved = true;
        }
        catch (HttpRequestException)
        {
            _saveError = "Save failed. Please try again.";
        }
    }

    private async Task DeleteAccountAsync()
    {
        _deleting = true;
        _deleteError = null;

        var result = await Auth.DeleteMyAccountAsync(_cts.Token);

        _deleting = false;

        if (result.Success)
            Navigation.NavigateTo("/", forceLoad: true);
        else
            _deleteError = result.Error ?? "Delete failed. Please try again.";
    }

    public void Dispose() => _cts.Cancel();
}